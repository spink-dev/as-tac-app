FROM node:24-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Optional live collaboration; only public values (URL + publishable key) are ever built in.
ARG VITE_SUPABASE_URL=""
ARG VITE_SUPABASE_PUBLISHABLE_KEY=""
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY
# Shown as the build in the app (the build context has no .git): --build-arg BUILD_COMMIT=$(git rev-parse --short HEAD)
ARG BUILD_COMMIT=""
ENV BUILD_COMMIT=$BUILD_COMMIT
RUN npm run build

FROM nginx:alpine
COPY docker/security-headers.conf /etc/nginx/snippets/security-headers.conf
# anti-ai (generated by `npm run anti-ai`): maps in the http context (00- sorts before default.conf),
# enforcement in the server block, policy headers in every location. Refusals are logged to
# /var/log/nginx/anti-ai/ — mount it on the host for fail2ban (docker/anti-ai/fail2ban/).
COPY docker/anti-ai/http.conf /etc/nginx/conf.d/00-anti-ai.conf
COPY docker/anti-ai/server.conf /etc/nginx/snippets/anti-ai-server.conf
COPY docker/anti-ai/headers.conf /etc/nginx/snippets/anti-ai-headers.conf
RUN mkdir -p /var/log/nginx/anti-ai
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
