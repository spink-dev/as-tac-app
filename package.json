{
  "name": "as-tac-app",
  "private": true,
  "type": "module",
  "version": "1.0.0-alpha.3",
  "description": "AS-TAC: offline-first tactical map planning, field navigation and live briefing for airsoft.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node tests/e2e/run.mjs",
    "check": "npm run typecheck && npm run test && npm run test:anti-ai && npm run build",
    "anti-ai": "node anti-ai/bin/anti-ai.mjs build",
    "test:anti-ai": "node anti-ai/bin/anti-ai.mjs check && node --test \"anti-ai/test/*.test.mjs\"",
    "map:build": "node scripts/build-maps.mjs",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "dexie": "4.4.7",
    "fflate": "0.8.3",
    "gsap": "3.15.1",
    "immer": "11.2.9",
    "lenis": "1.3.27",
    "lucide-react": "1.70.0",
    "maplibre-gl": "6.17.0",
    "osmtogeojson": "3.0.0-beta.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uqr": "0.1.3",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/functions": "3.11.0",
    "@vitejs/plugin-react": "6.2.1",
    "fake-indexeddb": "6.2.7",
    "jsdom": "31.0.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15"
  }
}
