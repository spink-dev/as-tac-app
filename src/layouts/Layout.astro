---
import '../styles/globals.css';
import '../styles/appearance.css';
---
<!doctype html>
<html lang="de">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta name="theme-color" content="#f4f5f6" />
        <script is:inline>
            (() => {
                let theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                try {
                    const saved = localStorage.getItem('as-tac.appearance');
                    if (['light', 'dark', 'red'].includes(saved)) {
                        theme = saved;
                    }
                } catch {}
                document.documentElement.dataset.theme = theme;
                document.querySelector('meta[name="theme-color"]').content = { light: '#f4f5f6', dark: '#171a1e', red: '#100505' }[theme];
            })();
        </script>
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <link rel="apple-touch-icon" href="/icon-192.png" />
        <link rel="manifest" href="/manifest.webmanifest" />
        <link rel="icon" type="image/svg+xml" href="/icon.svg" />
        <title>as-tac · Karte</title>
    </head>
    <body><slot /></body>
</html>
